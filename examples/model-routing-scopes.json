{
  "version": 1,
  "global": {
    "enforce": false
  },
  "roles": [
    {
      "match": {
        "provider": "*-supervisor"
      },
      "role": "supervisor"
    },
    {
      "match": {
        "labels": {
          "team-role": "lead"
        }
      },
      "role": "lead"
    }
  ],
  "projects": {
    "prj-example": {
      "set": "careful",
      "enforce": true
    }
  },
  "workspaces": {
    "ws-example": {
      "set": "fast",
      "enforce": true
    }
  }
}
